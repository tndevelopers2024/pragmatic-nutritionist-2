{
  "name": "pragmatic-nutritionist",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "frontend",
    "backend",
    "shared"
  ],
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:frontend": "npm run dev --workspace frontend --",
    "dev:backend": "npm run dev --workspace backend --",
    "build": "npm run build --workspace frontend",
    "start": "npm run start --workspace backend",
    "lint": "eslint .",
    "preview": "npm run preview --workspace frontend --",
    "test": "npm run test --workspace frontend && npm run test --workspace backend",
    "cms:create-admin": "npm run cms:create-admin --workspace backend --",
    "cms:migrate-blogs": "npm run cms:migrate-blogs --workspace backend --",
    "test:cms": "npm run test:cms --workspace backend"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0"
  },
  "engines": {
    "node": "24.x"
  }
}
