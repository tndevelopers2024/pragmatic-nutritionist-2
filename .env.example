# SMTP credentials used by api/send-mail.js (set the same keys in Vercel > Project Settings > Environment Variables)
# Gmail: smtp.gmail.com / 587 / full address / 16-character App Password (requires 2-Step Verification)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-address@example.com
SMTP_PASS=your-app-password

# Where enquiries are delivered
MAIL_TO=meenu@pragmaticnutritionist.com
# Optional display sender (must be allowed by your SMTP provider)
# MAIL_FROM="Pragmatic Nutrition Website" <your-address@example.com>
